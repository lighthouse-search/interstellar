{
    "request": {
        "limit": {
            "max_request_body_size": 45000000,
            "keep_alive_timeout_from_minutes": 60
        },
        "cors": {
            "allowed_origins": [
                "http://127.0.0.1:3001"
            ]
        }
    },
    "authentication": {
        "my_awesome_redis_auth_server": {
            "type": "redis"
        }
    },
    "storage": {
        "awesome_bucket": {
            "type": "s3",
            "host": "https://s3.example.com",
            "bucket_name": "your_s3_bucket_name",
            "access_key_env": "",
            "secret_access_key_env": "",
            "region": "auto"
        }
    },
    "database": {
        "my_awesome_redis": {
            "type": "redis",
            "hosts": ["https://s3.example.com"],
            "username_env": "",
            "password_env": ""
        }
    },
    "modes": {
        "default": {
            "type": "file",
            "storage_reference": {
                "id": "awesome_bucket",
                "path": "/%asset_id%"
            },
            "authentication_reference": {
                "id": "my_awesome_redis_auth_server"
            },
            "database_reference": {
                "id": "my_awesome_redis"
            },
            "status": {
                "status_update": "http://127.0.0.1:4455/api/internal/video/status/update"
            },
            "features": {
                "file_types": [
                ],
                "file_alias": {
                }
            },
            "video_limits": {
            },
            "post_processing": {
            }
        }
    },
    "message": {
        "fatal_error": "Sorry, there was an error."
    }
}